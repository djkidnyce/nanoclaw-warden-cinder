LOG_LEVEL=INFO
REDIS_HOST=redis.nanoclaw.svc.cluster.local
REDIS_PORT=6379
REDIS_TLS=false
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_ALLOWLIST=claude-sonnet-5-5,claude-haiku-5-5
UPSTREAM_URL=https://api.anthropic.com
UPSTREAM_API_VERSION=2023-06-01
UPSTREAM_TIMEOUT_SECONDS=170
MAX_TOKENS_CAP=4096
AGENT_MAX_TOKENS=2048
RATE_LIMIT_PER_MIN=30
MAX_CALLS_PER_TOKEN=20
MAX_REQUEST_BYTES=262144
MAX_RESPONSE_BYTES=2097152
MAX_TOOL_DESCRIPTION_CHARS=1000
ALLOWED_TOOLS=
MAX_SUBTASKS=50
MAX_INPUT_CHARS=32000
MAX_RESULT_CHARS=64000
MAX_PROPOSED_ACTIONS=20
MAX_ATTEMPTS=3
VISIBILITY_TIMEOUT_SECONDS=1200
CONTROLLER_CLAIM_IDLE_SECONDS=120
SWEEP_INTERVAL_SECONDS=60
RECORD_TTL_SECONDS=86400
TOKEN_TTL_SECONDS=1800
STREAM_MAXLEN=10000
VAULT_WAIT_SECONDS=180
VAULT_REQUEST_TIMEOUT_SECONDS=180
CLAIM_WAIT_SECONDS=5
