# Single source of truth for every pinned version in this repo.
# Scripts source this file. Tests fail if a manifest, README or workflow drifts from it.
# Renovate reads the comments above each line and opens PRs when upstream moves.
# Last verified against upstream release tags: 2026-11-22

# renovate: datasource=github-releases depName=kedacore/keda
KEDA_VERSION=2.21.1
# Oldest KEDA allowed by preflight. 2.21.0 fixes CVE-2026-77524.
KEDA_MIN_VERSION=2.21.0

# renovate: datasource=github-releases depName=cilium/cilium
CILIUM_VERSION=1.20.5

# renovate: datasource=github-releases depName=projectcalico/calico
CALICO_VERSION=3.33.1

# renovate: datasource=docker depName=redis
REDIS_VERSION=8.12.0

# renovate: datasource=docker depName=python
PYTHON_VERSION=3.13.18

# renovate: datasource=pypi depName=redis
REDIS_PY_VERSION=8.1.0

# Oldest Kubernetes server the manifests support (ValidatingAdmissionPolicy v1, native sidecars).
K8S_MIN_VERSION=1.32
# renovate: datasource=github-releases depName=kubernetes-sigs/controller-tools extractVersion=^envtest-v(?<version>.*)$
ENVTEST_K8S_VERSION=1.37.0

# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=0.33.0
# renovate: datasource=github-releases depName=stackrox/kube-linter
KUBE_LINTER_VERSION=0.8.3
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=0.8.0
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/v(?<version>.*)$
KUSTOMIZE_VERSION=5.8.3

# Runtime image built from this repo.
RUNTIME_IMAGE=ghcr.io/djkidnyce/nanoclaw-warden-cinder/runtime
RUNTIME_VERSION=0.2.0
